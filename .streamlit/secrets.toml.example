# Copy this file to .streamlit/secrets.toml and fill in your real key.
# .streamlit/secrets.toml should NOT be committed to git.
#
# On Streamlit Community Cloud: skip this file entirely and instead paste the
# same two lines into your app's Settings -> Secrets in the dashboard UI.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional — defaults to "claude-sonnet-5" if omitted.
# ANTHROPIC_MODEL = "claude-sonnet-5"
